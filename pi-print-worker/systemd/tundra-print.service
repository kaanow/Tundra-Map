[Unit]
Description=Tundra-Map print worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaan
WorkingDirectory=/srv/repo/tundra-map/pi-print-worker
EnvironmentFile=/etc/tundra-print.env
ExecStart=/srv/repo/tundra-map/pi-print-worker/.venv/bin/python worker.py
Restart=always
RestartSec=5
# The worker only needs USB access to the printer; systemd doesn't need
# extra caps because the printer node's permissions are set by udev.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log /var/lib/tundra-labels
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
