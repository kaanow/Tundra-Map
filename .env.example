# Backend (Railway service env)
DATABASE_URL=postgres://user:pass@host:5432/frz
PUBLIC_BASE_URL=https://frz.up.railway.app
PHOTO_DIR=/data/photos   # mount a Railway volume at /data

# Pi print worker (/etc/tundra-print.env on the Pi)
# DATABASE_URL, PUBLIC_BASE_URL as above
PRINTER_MODEL=QL-810W
PRINTER_BACKEND=network      # `network` (tcp://ip:9100), `linux_kernel`, or `file` for dry-run
PRINTER_IDENT=tcp://192.168.4.133:9100
LABEL_SIZE=62                # DK-2205 continuous 62mm
FILE_BACKEND_DIR=/var/lib/tundra-labels   # only used when PRINTER_BACKEND=file; must be in ReadWritePaths= of the systemd unit
